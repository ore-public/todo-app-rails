- content_for :title, t('.title')
.ly_narrow
  %h1.el_pageTitle
    = t('.title')
  = form_with model: @user, url: registration_path, class: 'bl_authForm' do |form|
    = render 'shared/error_messages', model: @user
    .bl_authForm_field
      = form.label :email_address, class: 'form-label'
      = form.email_field :email_address, required: true, autofocus: true, autocomplete: 'username', class: 'form-control'
    .bl_authForm_field
      = form.label :password, class: 'form-label'
      = form.password_field :password, required: true, autocomplete: 'new-password', maxlength: 72, class: 'form-control'
    .bl_authForm_field
      = form.label :password_confirmation, class: 'form-label'
      = form.password_field :password_confirmation, required: true, autocomplete: 'new-password', maxlength: 72, class: 'form-control'
    = form.submit t('.submit'), class: 'btn btn-primary'
  %p.bl_authForm_links
    = link_to t('.sign_in'), new_session_path
