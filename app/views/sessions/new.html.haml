- content_for :title, t('.title')
.ly_narrow
  %h1.el_pageTitle
    = t('.title')
  = form_with url: session_path, class: 'bl_authForm' do |form|
    .bl_authForm_field
      = form.label :email_address, t('.email_address'), class: 'form-label'
      = form.email_field :email_address, required: true, autofocus: true, autocomplete: 'username', value: params[:email_address], class: 'form-control'
    .bl_authForm_field
      = form.label :password, t('.password'), class: 'form-label'
      = form.password_field :password, required: true, autocomplete: 'current-password', maxlength: 72, class: 'form-control'
    = form.submit t('.submit'), class: 'btn btn-primary'
  %p.bl_authForm_links
    = link_to t('.forgot_password'), new_password_path
    = link_to t('.sign_up'), new_registration_path
